      "source": [
        "df[\"CASE_STATUS_CLEAN\"] = df[status_col].astype(str).str.upper().str.strip()\n",
        "\n",
        "certified_values = [\"CERTIFIED\", \"CERTIFIED-EXPIRED\", \"CERTIFIED EXPIRED\"]\n",
        "df[\"OUTCOME_BINARY\"] = np.where(df[\"CASE_STATUS_CLEAN\"].isin(certified_values), \"CERTIFIED_GROUP\", \"OTHER_OUTCOME\")\n",
        "\n",
        "if received_date_col and decision_date_col:\n",
        "    df[\"DAYS_TO_DECISION\"] = (df[decision_date_col] - df[received_date_col]).dt.days\n",
        "    df.loc[df[\"DAYS_TO_DECISION\"] < 0, \"DAYS_TO_DECISION\"] = np.nan\n",
        "else:\n",
        "    df[\"DAYS_TO_DECISION\"] = np.nan\n",
        "\n",
        "if received_date_col:\n",
        "    df[\"RECEIVED_YEAR\"] = df[received_date_col].dt.year\n",
        "    df[\"RECEIVED_MONTH\"] = df[received_date_col].dt.to_period(\"M\").astype(str)\n",
        "\n",
        "if decision_date_col:\n",
        "    df[\"DECISION_YEAR\"] = df[decision_date_col].dt.year\n",
        "    df[\"DECISION_MONTH\"] = df[decision_date_col].dt.to_period(\"M\").astype(str)\n",
        "\n",
        "if wage_col and pd.api.types.is_numeric_dtype(df[wage_col]):\n",
        "    valid_wage = df[wage_col].where(df[wage_col] > 0)\n",
        "    try:\n",
        "        df[\"WAGE_BAND\"] = pd.qcut(valid_wage, q=4, duplicates=\"drop\").astype(str)\n",
        "    except ValueError:\n",
        "        df[\"WAGE_BAND\"] = np.nan\n",
        "\n",
        "target_summary = df[[\"CASE_STATUS_CLEAN\", \"OUTCOME_BINARY\", \"DAYS_TO_DECISION\"]].head()\n",
        "display(target_summary)"
      ]
    },
