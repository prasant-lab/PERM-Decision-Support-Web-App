        "from sklearn.inspection import permutation_importance\n",
        "\n",
        "sample_size = min(2000, X_test.shape[0])\n",
        "X_explain = X_test.sample(sample_size, random_state=42)\n",
        "y_explain = y_test.loc[X_explain.index]\n",
        "\n",
        "perm = permutation_importance(\n",
        "    best_classification_model,\n",
        "    X_explain,\n",
        "    y_explain,\n",
        "    n_repeats=5,\n",
        "    random_state=42,\n",
        "    scoring=\"f1_macro\",\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "importance_df = pd.DataFrame({\n",
        "    \"Feature\": X_explain.columns,\n",
        "    \"Importance\": perm.importances_mean\n",
        "}).sort_values(\"Importance\", ascending=False).head(15)\n",
        "\n",
        "display(importance_df)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 7))\n",
        "ax.barh(importance_df[\"Feature\"][::-1], importance_df[\"Importance\"][::-1], color=palette[:len(importance_df)])\n",
        "ax.set_title(\"Top Model Features by Permutation Importance\", fontweight=\"bold\", pad=15)\n",
        "ax.set_xlabel(\"Importance\", fontweight=\"bold\")\n",
        "ax.set_ylabel(\"Feature\", fontweight=\"bold\")\n",
        "for i, value in enumerate(importance_df[\"Importance\"][::-1]):\n",
        "    ax.text(value, i, f\" {value:.4f}\", va=\"center\", fontsize=9, fontweight=\"bold\")\n",
        "save_plot(\"explainability_permutation_importance.png\")\n",
        "importance_df.to_csv(REPORTS_DIR / \"permutation_importance.csv\", index=False)"
      ]
