        "def find_column(columns, exact_names=None, contains_all=None, contains_any=None, exclude=None):\n",
        "    exact_names = [clean_column_name(x) for x in exact_names] if exact_names else []\n",
        "    contains_all = [clean_column_name(x) for x in contains_all] if contains_all else []\n",
        "    contains_any = [clean_column_name(x) for x in contains_any] if contains_any else []\n",
        "    exclude = [clean_column_name(x) for x in exclude] if exclude else []\n",
        "\n",
        "    for name in exact_names:\n",
        "        if name in columns:\n",
        "            return name\n",
        "\n",
        "    for col in columns:\n",
        "        blocked = any(item in col for item in exclude)\n",
        "        if blocked:\n",
        "            continue\n",
        "        all_match = all(item in col for item in contains_all) if contains_all else True\n",
        "        any_match = any(item in col for item in contains_any) if contains_any else True\n",
        "        if all_match and any_match:\n",
        "            return col\n",
        "\n",
        "    return None\n",
        "\n",
        "columns = list(df.columns)\n",
        "\n",
        "case_number_col = find_column(columns, exact_names=[\"CASE_NUMBER\", \"CASE_NO\"])\n",
        "status_col = find_column(columns, exact_names=[\"CASE_STATUS\", \"DECISION_STATUS\"], contains_all=[\"STATUS\"])\n",
        "received_date_col = find_column(columns, exact_names=[\"RECEIVED_DATE\", \"CASE_RECEIVED_DATE\", \"FILING_DATE\"], contains_any=[\"RECEIVED\", \"FILING\"])\n",
        "decision_date_col = find_column(columns, exact_names=[\"DECISION_DATE\", \"DETERMINATION_DATE\"], contains_any=[\"DECISION\", \"DETERMINATION\"])\n",
        "worksite_state_col = find_column(columns, exact_names=[\"WORKSITE_STATE\", \"WORKSITE_STATE_ABBREVIATION\"], contains_all=[\"WORKSITE\", \"STATE\"])\n",
        "employer_state_col = find_column(columns, exact_names=[\"EMPLOYER_STATE\", \"EMPLOYER_STATE_PROVINCE\"], contains_all=[\"EMPLOYER\", \"STATE\"])\n",
        "soc_title_col = find_column(columns, exact_names=[\"PW_SOC_TITLE\", \"SOC_TITLE\"], contains_all=[\"SOC\", \"TITLE\"])\n",
        "job_title_col = find_column(columns, exact_names=[\"JOB_TITLE\"], contains_all=[\"JOB\", \"TITLE\"])\n",
        "wage_col = find_column(columns, exact_names=[\"WAGE_OFFER_FROM\", \"PW_WAGE\", \"PREVAILING_WAGE\"], contains_any=[\"WAGE\", \"SALARY\"], exclude=[\"UNIT\"])\n",
        "\n",
        "detected_columns = pd.DataFrame({\n",
        "    \"Role\": [\"Case Number\", \"Case Status\", \"Received Date\", \"Decision Date\", \"Worksite State\", \"Employer State\", \"SOC Title\", \"Job Title\", \"Wage\"],\n",
        "    \"Column\": [case_number_col, status_col, received_date_col, decision_date_col, worksite_state_col, employer_state_col, soc_title_col, job_title_col, wage_col]\n",
        "})\n",
